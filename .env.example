# Public app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only Supabase
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Cloudflare R2, S3-compatible API
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
R2_BUCKET=pettravel-wholesale
R2_PUBLIC_BASE_URL=https://pub-example.r2.dev

# Payment QR provider placeholder
PAYMENT_QR_BANK_NAME=Pet Travel
PAYMENT_QR_ACCOUNT_NO=replace-with-bank-account
PAYMENT_QR_ACCOUNT_NAME=PET TRAVEL WHOLESALE

# Security
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_TOKEN=replace-with-one-time-bootstrap-token
ADMIN_EMAILS=owner@example.com
JWT_SECRET=replace-with-at-least-32-random-characters
PASSWORD_PEPPER=replace-with-at-least-32-random-characters
ALLOW_DEMO_DATA=false
ALLOW_RUNTIME_MIGRATIONS=false
CRON_SECRET=replace-with-random-secret
